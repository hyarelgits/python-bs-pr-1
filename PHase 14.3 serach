Step 7: Modify Search Route

Replace old route with:



@app.route("/search", methods=["GET"])
def search():

    name = request.args.get("name")

    if not name:

        return render_template(
            "search.html"
        )

    conn = sqlite3.connect(
        "students.db"
    )

    cursor = conn.cursor()

    cursor.execute(
        "SELECT * FROM students WHERE name=?",
        (name,)
    )

    rows = cursor.fetchall()

    conn.close()

    return str(rows)



