@app.route("/search")
def search():

    name = request.args.get("name")

    conn = sqlite3.connect("students.db")

    cursor = conn.cursor()

    cursor.execute(
        "SELECT * FROM students WHERE name=?",
        (name,)
    )

    rows = cursor.fetchall()

    conn.close()

    return str(rows)



