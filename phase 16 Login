Step 11: Protect Student Page

Modify /students route.

Current:

@app.route("/students")
def students():


@app.route("/students")
def students():

    if "user" not in session:

        return "Please Login First"

    conn = sqlite3.connect("students.db")

    cursor = conn.cursor()

    cursor.execute(
        "SELECT * FROM students"
    )

    rows = cursor.fetchall()

    conn.close()

    return render_template(
        "students.html",
        rows=rows
    )


