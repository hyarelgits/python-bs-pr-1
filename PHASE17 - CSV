Make CSV Export Available From Browser

Add route in app.py:

Python
from flask import send_file


@app.route("/export")
def export():

    import csv

    conn = sqlite3.connect("students.db")

    cursor = conn.cursor()

    cursor.execute(
        "SELECT * FROM students"
    )

    rows = cursor.fetchall()

    with open(
        "students.csv",
        "w",
        newline=""
    ) as file:

        writer = csv.writer(file)

        writer.writerow(
            ["ID", "Name", "Marks"]
        )

        writer.writerows(rows)

    conn.close()

    return send_file(
        "students.csv",
        as_attachment=True
    )



