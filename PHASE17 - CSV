Step 2: Add Code

import sqlite3
import csv

# Connect Database
conn = sqlite3.connect("students.db")

cursor = conn.cursor()

# Get Student Data
cursor.execute(
    "SELECT * FROM students"
)

rows = cursor.fetchall()

# Create CSV File
with open(
    "students.csv",
    "w",
    newline=""
) as file:

    writer = csv.writer(file)

    # Header Row
    writer.writerow(
        ["ID", "Name", "Marks"]
    )

    # Student Rows
    writer.writerows(rows)

conn.close()

print("CSV File Created Successfully")


