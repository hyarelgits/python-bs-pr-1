Step 2: Add Update Route

Add this code above:

Python
if __name__ == "__main__":
 

@app.route("/update")
def update():

    conn = sqlite3.connect("students.db")

    cursor = conn.cursor()

    cursor.execute(
        "UPDATE students SET marks=95 WHERE id=1"
    )

    conn.commit()

    conn.close()

    return "Student Updated Successfully"


