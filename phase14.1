@app.route("/students")
def students():

    conn = sqlite3.connect("students.db")

    cursor = conn.cursor()

    cursor.execute(
        "SELECT * FROM students"
    )

    rows = cursor.fetchall()

    conn.close()

    return render_template(
        "students.html",
        rows=rows
    )




